                                        <div class="progress-bar-wrap" style="flex: 1; max-width: 120px;">
                                            <div class="progress-bar-fill" style="width: @student.Progress%;"></div>
                                        </div>
                                        <span style="font-size: 0.82rem; font-weight: 500; min-width: 35px;">@student.Progress%</span>
                                    </div>
                                </td>
                                <td style="padding: 0.75rem 1rem; color: var(--muted); font-size: 0.85rem;">@student.Joined</td>
                                <td style="padding: 0.75rem 1rem;">
