                            <div style="font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;">Average Rating</div>
                            <div style="font-family: var(--ff-serif); font-size: 1.5rem; font-weight: 600;">⭐ 4.7</div>
                        </div>
