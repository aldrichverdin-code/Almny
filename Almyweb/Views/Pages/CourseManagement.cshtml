                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Course Content -->
        <div id="tab-content" class="tab-content">
            <div style="background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                    <h3 style="font-family: var(--ff-serif); font-size: 1.3rem;">Course Structure</h3>
