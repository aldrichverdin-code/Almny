@{
    ViewData["Title"] = "Course Management";
    var courseId = ViewBag.CourseId ?? 0;

    // Datos de ejemplo para el instructor
    var course = new
    {
        Title = "Full-Stack Web Development",
        Category = "Programming",
        Instructor = "You",
        Price = "$49.99",
        Description = "Master full-stack development with React, Node.js, and MongoDB.",
        Created = "2024-01-15",
        LastUpdated = "2024-02-20",
        TotalStudents = 12,
        TotalSections = 3,
        TotalLessons = 12,
        TotalExams = 2,
        AverageRating = 4.7,
        EnrolledStudents = new List<dynamic> {
            new { Name = "John Doe", Email = "john@example.com", Progress = 75, Joined = "2024-01-20" },
            new { Name = "Jane Smith", Email = "jane@example.com", Progress = 45, Joined = "2024-01-22" },
            new { Name = "Mike Johnson", Email = "mike@example.com", Progress = 90, Joined = "2024-01-25" },
            new { Name = "Sarah Williams", Email = "sarah@example.com", Progress = 30, Joined = "2024-02-01" }
        },
        ExamResults = new List<dynamic> {
            new { Student = "John Doe", Exam = "Final Exam", Score = 85, Status = "Passed", Date = "2024-02-15" },
            new { Student = "Jane Smith", Exam = "Final Exam", Score = 62, Status = "Failed", Date = "2024-02-16" },
            new { Student = "Mike Johnson", Exam = "Final Exam", Score = 92, Status = "Passed", Date = "2024-02-17" },
            new { Student = "John Doe", Exam = "Module 1 Quiz", Score = 78, Status = "Passed", Date = "2024-01-25" },
            new { Student = "Mike Johnson", Exam = "Module 1 Quiz", Score = 88, Status = "Passed", Date = "2024-01-26" }
        }
    };
}

<div class="page active" id="page-course-management">
    <div class="page-inner">
        <!-- Header con información del curso -->
        <div style="background: var(--ink); color: var(--paper); padding: 2rem; border-radius: 10px; margin-bottom: 2rem;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <a href="/Pages/Instructor" class="btn btn-ghost btn-sm" style="color: rgba(244, 241, 235, 0.5); padding-left: 0;">
                        ← Back to Dashboard
                    </a>
                    <div style="font-family: var(--ff-mono); font-size: 0.7rem; letter-spacing: 0.14em; color: var(--gold); margin-top: 1rem;">
                        @course.Category
                    </div>
                    <h1 style="font-family: var(--ff-serif); font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 300; margin: 0.5rem 0 0.75rem;">
                        @course.Title
                    </h1>
                    <p style="font-size: 0.9rem; color: rgba(244, 241, 235, 0.7); max-width: 560px;">
                        @course.Description
                    </p>
                    <div style="display: flex; gap: 1.5rem; margin-top: 1rem; font-size: 0.82rem; color: rgba(244, 241, 235, 0.55);">
                        <span>👤 @course.Instructor</span>
                        <span>📅 Created: @course.Created</span>
                        <span>🔄 Updated: @course.LastUpdated</span>
                    </div>
                </div>
                <div style="background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 10px; padding: 1.5rem; min-width: 200px;">
                    <div style="font-family: var(--ff-serif); font-size: 2rem; font-weight: 600; color: var(--gold);">
                        @course.Price
                    </div>
                    <div style="font-size: 0.78rem; color: rgba(244, 241, 235, 0.5);">
                        ⭐ @course.AverageRating / 5.0
                    </div>
                    <div style="font-size: 0.78rem; color: rgba(244, 241, 235, 0.5); margin-top: 0.5rem;">
                        👨‍🎓 @course.TotalStudents students
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats rápidas -->
        <div class="dash-grid" style="margin-bottom: 2rem;">
            <div class="dash-stat">
                <div class="dash-stat-icon gold">📚</div>
                <div>
                    <div class="dash-stat-val">@course.TotalSections</div>
                    <div class="dash-stat-lbl">Sections</div>
                </div>
            </div>
            <div class="dash-stat">
                <div class="dash-stat-icon sage">📖</div>
                <div>
                    <div class="dash-stat-val">@course.TotalLessons</div>
                    <div class="dash-stat-lbl">Lessons</div>
                </div>
            </div>
            <div class="dash-stat">
                <div class="dash-stat-icon rust">📝</div>
                <div>
                    <div class="dash-stat-val">@course.TotalExams</div>
                    <div class="dash-stat-lbl">Exams</div>
                </div>
            </div>
            <div class="dash-stat">
                <div class="dash-stat-icon ink">👨‍🎓</div>
                <div>
                    <div class="dash-stat-val">@course.TotalStudents</div>
                    <div class="dash-stat-lbl">Students Enrolled</div>
                </div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="tabs">
            <span class="tab active" data-tab="students">Students</span>
            <span class="tab" data-tab="exams-results">Exam Results</span>
            <span class="tab" data-tab="content">Course Content</span>
            <span class="tab" data-tab="attendance">Attendance</span>
            <span class="tab" data-tab="analytics">Analytics</span>
        </div>

        <!-- Students -->
        <div id="tab-students" class="tab-content active">
            <div style="background: var(--card); border: 1px solid var(--border); border-radius: 10px; overflow: hidden;">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="background: var(--cream); border-bottom: 2px solid var(--border);">
                            <th style="padding: 0.75rem 1rem; text-align: left; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted);">Student</th>
                            <th style="padding: 0.75rem 1rem; text-align: left; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted);">Email</th>
                            <th style="padding: 0.75rem 1rem; text-align: left; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted);">Progress</th>
                            <th style="padding: 0.75rem 1rem; text-align: left; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted);">Joined</th>
                            <th style="padding: 0.75rem 1rem; text-align: left; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted);">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in course.EnrolledStudents)
                        {
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 0.75rem 1rem; font-weight: 500;">@student.Name</td>
                                <td style="padding: 0.75rem 1rem; color: var(--muted);">@student.Email</td>
                                <td style="padding: 0.75rem 1rem;">
