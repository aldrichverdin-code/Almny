                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 0.75rem 1rem; font-weight: 500;">@result.Student</td>
                                <td style="padding: 0.75rem 1rem;">@result.Exam</td>
                                <td style="padding: 0.75rem 1rem; font-weight: 600;">@result.Score%</td>
                                <td style="padding: 0.75rem 1rem;">
                                    <span style="display: inline-block; padding: 0.2rem 0.8rem; border-radius: 20px; font-size: 0.78rem; font-weight: 500; background: @statusBg; color: @statusColor;">
                                        @result.Status
                                    </span>
                                </td>
                                <td style="padding: 0.75rem 1rem; color: var(--muted); font-size: 0.85rem;">@result.Date</td>
                                <td style="padding: 0.75rem 1rem;">
                                    <div style="display: flex; gap: 0.5rem;">
                                        <a href="@Url.Action("ViewExam", "Pages", new { student = result.Student, exam = result.Exam })" class="btn btn-ghost btn-sm">👁️ View</a>
