                            <div style="font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;">Revenue</div>
                            <div style="font-family: var(--ff-serif); font-size: 1.5rem; font-weight: 600;">$1,499</div>
                        </div>
                    </div>
