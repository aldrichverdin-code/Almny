@{
    ViewData["Title"] = "Exam";
}

<div class="page active" id="page-exam">
    <div class="page-inner" style="max-width: 720px">
        <a href="/Pages/MyLearn" class="btn btn-ghost btn-sm mb-2" style="padding-left: 0;">
            ← Back to My Learning
        </a>

        <div id="exam-content">
            <!-- Header del examen -->
            <div style="background: var(--ink); color: var(--paper); padding: 2rem; border-radius: 10px; margin-bottom: 1.5rem;">
                <div style="font-family: var(--ff-mono); font-size: 0.7rem; letter-spacing: 0.14em; color: var(--gold); margin-bottom: 0.5rem;">
                    📝 Course Exam
                </div>
                <h2 style="font-family: var(--ff-serif); font-size: 1.8rem; font-weight: 300; margin: 0.5rem 0;">
                    Final Exam - Web Development Basics
                </h2>
                <div style="display: flex; gap: 1.5rem; font-size: 0.85rem; color: rgba(244, 241, 235, 0.6); margin-top: 1rem;">
                    <span>📋 10 questions</span>
                    <span>⏱️ 30 minutes</span>
                    <span>✅ Passing score: 70%</span>
                </div>
            </div>

            <!-- Progreso -->
            <div style="background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; margin-bottom: 1.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <span style="font-size: 0.85rem; font-weight: 500;">Question <span id="current-q">1</span> of <span id="total-q">10</span></span>
                    <span style="font-size: 0.85rem; color: var(--muted);">⏱️ <span id="timer">29:30</span></span>
                </div>
                <div class="progress-bar-wrap">
                    <div class="progress-bar-fill" style="width: 10%;"></div>
                </div>
            </div>

            <!-- Pregunta -->
            <div style="background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; margin-bottom: 1.5rem;">
                <h3 style="font-family: var(--ff-serif); font-size: 1.25rem; line-height: 1.5; margin-bottom: 1.5rem;">
                    What is the correct HTML tag for creating a hyperlink?
                </h3>

                <div class="quiz-options">
                    <div class="quiz-option">
                        <span class="quiz-option-letter">A</span>
                        <span>&lt;link&gt;</span>
                    </div>
                    <div class="quiz-option selected">
                        <span class="quiz-option-letter">B</span>
                        <span>&lt;a&gt;</span>
                    </div>
                    <div class="quiz-option">
                        <span class="quiz-option-letter">C</span>
                        <span>&lt;href&gt;</span>
                    </div>
                    <div class="quiz-option">
                        <span class="quiz-option-letter">D</span>
                        <span>&lt;url&gt;</span>
                    </div>
                </div>
            </div>

            <!-- Botones de navegación -->
            <div style="display: flex; justify-content: space-between; gap: 1rem;">
                <button class="btn btn-outline" style="flex: 1;">
                    ← Previous
                </button>
                <button class="btn btn-primary" style="flex: 1;">
                    Next →
                </button>
            </div>

            <!-- Botón de finalizar -->
            <div style="margin-top: 1.5rem; text-align: center;">
                <button class="btn btn-gold" style="width: 100%; max-width: 300px;">
                    📤 Submit Exam
                </button>
            </div>
        </div>
    </div>
</div>