@{
    ViewData["Title"] = "Grade Exam";
    var studentName = ViewBag.StudentName ?? "John Doe";
    var examName = ViewBag.ExamName ?? "Final Exam";
}

<div class="page active" id="page-grade-exam">
    <div class="page-inner" style="max-width: 900px;">
        <a href="@Url.Action("CourseManagement", "Pages", new { id = 1 })" class="btn btn-ghost btn-sm mb-2" style="padding-left: 0;">
            ← Back to Course Management
        </a>

        <!-- Header -->
        <div style="background: var(--ink); color: var(--paper); padding: 2rem; border-radius: 10px; margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <div style="font-family: var(--ff-mono); font-size: 0.7rem; letter-spacing: 0.14em; color: var(--gold); margin-bottom: 0.5rem;">
                        📝 Grade Exam
                    </div>
                    <h2 style="font-family: var(--ff-serif); font-size: 1.8rem; font-weight: 300; margin: 0.5rem 0;">
                        @examName
                    </h2>
                    <div style="display: flex; gap: 1rem; font-size: 0.85rem; color: rgba(244, 241, 235, 0.6); margin-top: 0.5rem; flex-wrap: wrap;">
                        <span>👤 Student: <strong style="color: var(--paper);">@studentName</strong></span>
                        <span>📋 10 questions</span>
                        <span>✅ Passing score: 70%</span>
                    </div>
                </div>
                <div style="background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 10px; padding: 1rem 1.5rem; text-align: center; min-width: 120px;">
                    <div style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; color: rgba(244, 241, 235, 0.4);">Total Score</div>
                    <div style="font-family: var(--ff-serif); font-size: 2rem; font-weight: 600; color: var(--gold);" id="total-score">—</div>
                    <div style="font-size: 0.75rem; color: rgba(244, 241, 235, 0.4);">/ 100</div>
                </div>
            </div>
        </div>

        <!-- Preguntas para calificar -->
        <div id="grade-questions">
            <!-- Pregunta 1 - Opción Múltiple (Auto-calificada) -->
            <div class="grade-question" style="background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; margin-bottom: 1rem;">
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem;">
                    <h3 style="font-family: var(--ff-serif); font-size: 1.1rem; line-height: 1.5;">
                        <span style="color: var(--gold); font-weight: 600;">1.</span>
                        What is the correct HTML tag for creating a hyperlink?
                    </h3>
                    <span class="chip chip-gold">Auto-graded</span>
                </div>

                <div style="background: var(--cream); padding: 0.75rem 1rem; border-radius: var(--r); margin: 0.5rem 0;">
                    <div style="font-size: 0.75rem; color: var(--muted);">Student's Answer:</div>
                    <div style="font-weight: 500;">B. &lt;a&gt;</div>
                </div>

                <div style="display: flex; align-items: center; gap: 1rem; margin-top: 0.5rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 0.85rem; font-weight: 600; color: var(--sage);">✅ Correct</span>
                        <span style="font-size: 0.78rem; color: var(--muted);">(Auto-graded: 10/10)</span>
                    </div>
                </div>
            </div>

            <!-- Pregunta 2 - Opción Múltiple (Auto-calificada) -->
            <div class="grade-question" style="background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; margin-bottom: 1rem;">
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem;">
                    <h3 style="font-family: var(--ff-serif); font-size: 1.1rem; line-height: 1.5;">
                        <span style="color: var(--gold); font-weight: 600;">2.</span>
                        Which CSS property is used to change the text color?
                    </h3>
                    <span class="chip chip-gold">Auto-graded</span>
                </div>

                <div style="background: var(--cream); padding: 0.75rem 1rem; border-radius: var(--r); margin: 0.5rem 0;">
                    <div style="font-size: 0.75rem; color: var(--muted);">Student's Answer:</div>
                    <div style="font-weight: 500;">A. font-color</div>
                </div>

                <div style="display: flex; align-items: center; gap: 1rem; margin-top: 0.5rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 0.85rem; font-weight: 600; color: var(--rust);">❌ Incorrect</span>
                        <span style="font-size: 0.78rem; color: var(--muted);">(Auto-graded: 0/10)</span>
                    </div>
                    <div style="font-size: 0.78rem; color: var(--muted);">
                        Correct answer: <strong>C. color</strong>
                    </div>
                </div>
            </div>

            <!-- Pregunta 3 - Pregunta Abierta (Manual) -->
            <div class="grade-question" style="background: var(--card); border: 2px solid var(--gold); border-radius: 10px; padding: 1.5rem; margin-bottom: 1rem;">
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem;">
                    <h3 style="font-family: var(--ff-serif); font-size: 1.1rem; line-height: 1.5;">
                        <span style="color: var(--gold); font-weight: 600;">3.</span>
                        Explain the difference between `let`, `const`, and `var` in JavaScript. Provide examples.
                    </h3>
                    <span class="chip chip-sage">Manual Grading</span>
                </div>

                <div style="background: var(--cream); padding: 0.75rem 1rem; border-radius: var(--r); margin: 0.5rem 0;">
                    <div style="font-size: 0.75rem; color: var(--muted);">Student's Answer:</div>
                    <div style="white-space: pre-wrap; line-height: 1.6;">
                        var is function-scoped and can be redeclared. let is block-scoped and cannot be redeclared in the same scope.
                        const is block-scoped and cannot be reassigned. For example: var x = 1; let y = 2; const z = 3;
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem;">
                    <div>
                        <label style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); display: block; margin-bottom: 0.25rem;">
                            Score (0-10)
                        </label>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <input type="range" min="0" max="10" value="8" class="grade-slider" style="flex: 1; accent-color: var(--gold);" oninput="updateScore(this, 'score-3')">
                            <span id="score-3" style="font-family: var(--ff-serif); font-size: 1.2rem; font-weight: 600; min-width: 30px; color: var(--gold);">8</span>
                            <span style="font-size: 0.75rem; color: var(--muted);">/10</span>
                        </div>
                    </div>
                    <div>
                        <label style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); display: block; margin-bottom: 0.25rem;">
                            Feedback
                        </label>
                        <select class="form-select" style="font-size: 0.85rem;">
                            <option value="">Select feedback...</option>
                            <option value="excellent" selected>⭐ Excellent</option>
                            <option value="good">✅ Good</option>
                            <option value="satisfactory">📝 Satisfactory</option>
                            <option value="needs-improvement">🔄 Needs Improvement</option>
                            <option value="poor">❌ Poor</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Pregunta 4 - Pregunta Abierta (Manual) -->
            <div class="grade-question" style="background: var(--card); border: 2px solid var(--gold); border-radius: 10px; padding: 1.5rem; margin-bottom: 1rem;">
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem;">
                    <h3 style="font-family: var(--ff-serif); font-size: 1.1rem; line-height: 1.5;">
                        <span style="color: var(--gold); font-weight: 600;">4.</span>
                        Describe the CSS Box Model and its components.
                    </h3>
                    <span class="chip chip-sage">Manual Grading</span>
                </div>

                <div style="background: var(--cream); padding: 0.75rem 1rem; border-radius: var(--r); margin: 0.5rem 0;">
                    <div style="font-size: 0.75rem; color: var(--muted);">Student's Answer:</div>
                    <div style="white-space: pre-wrap; line-height: 1.6;">
                        The CSS Box Model consists of content, padding, border, and margin. Content is the actual content of the element.
                        Padding is space between content and border. Border is the line around the element. Margin is space outside the border.
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem;">
                    <div>
                        <label style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); display: block; margin-bottom: 0.25rem;">
                            Score (0-10)
                        </label>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <input type="range" min="0" max="10" value="6" class="grade-slider" style="flex: 1; accent-color: var(--gold);" oninput="updateScore(this, 'score-4')">
                            <span id="score-4" style="font-family: var(--ff-serif); font-size: 1.2rem; font-weight: 600; min-width: 30px; color: var(--gold);">6</span>
                            <span style="font-size: 0.75rem; color: var(--muted);">/10</span>
                        </div>
                    </div>
                    <div>
                        <label style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); display: block; margin-bottom: 0.25rem;">
                            Feedback
                        </label>
                        <select class="form-select" style="font-size: 0.85rem;">
                            <option value="">Select feedback...</option>
                            <option value="excellent">⭐ Excellent</option>
                            <option value="good">✅ Good</option>
                            <option value="satisfactory" selected>📝 Satisfactory</option>
                            <option value="needs-improvement">🔄 Needs Improvement</option>
                            <option value="poor">❌ Poor</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Pregunta 5 - Opción Múltiple (Auto-calificada) -->
            <div class="grade-question" style="background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; margin-bottom: 1rem;">
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.5rem;">
                    <h3 style="font-family: var(--ff-serif); font-size: 1.1rem; line-height: 1.5;">
                        <span style="color: var(--gold); font-weight: 600;">5.</span>
                        What does CSS stand for?
                    </h3>
                    <span class="chip chip-gold">Auto-graded</span>
                </div>

                <div style="background: var(--cream); padding: 0.75rem 1rem; border-radius: var(--r); margin: 0.5rem 0;">
                    <div style="font-size: 0.75rem; color: var(--muted);">Student's Answer:</div>
                    <div style="font-weight: 500;">B. Cascading Style Sheets</div>
                </div>

                <div style="display: flex; align-items: center; gap: 1rem; margin-top: 0.5rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 0.85rem; font-weight: 600; color: var(--sage);">✅ Correct</span>
                        <span style="font-size: 0.78rem; color: var(--muted);">(Auto-graded: 10/10)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Resumen y botones -->
        <div style="background: var(--cream); border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; margin-top: 1.5rem;">
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                <div style="text-align: center;">
                    <div style="font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;">Auto-graded Questions</div>
                    <div style="font-family: var(--ff-serif); font-size: 1.5rem; font-weight: 600;">3</div>
                </div>
                <div style="text-align: center;">
                    <div style="font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;">Manual Questions</div>
                    <div style="font-family: var(--ff-serif); font-size: 1.5rem; font-weight: 600;">2</div>
                </div>
                <div style="text-align: center;">
                    <div style="font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em;">Total Questions</div>
                    <div style="font-family: var(--ff-serif); font-size: 1.5rem; font-weight: 600;">5</div>
                </div>
            </div>

            <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                <button class="btn btn-primary" onclick="calculateTotal()" style="min-width: 150px;">
                    📊 Calculate Total
                </button>
                <button class="btn btn-gold" onclick="submitGrade()" style="min-width: 150px;">
                    ✅ Submit Grade
                </button>
                <a href="@Url.Action("CourseManagement", "Pages", new { id = 1 })" class="btn btn-outline" style="min-width: 150px;">
                    Cancel
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .grade-question {
        transition: box-shadow 0.2s;
    }

        .grade-question:hover {
            box-shadow: var(--shadow);
        }

    .chip-gold {
        background: rgba(201, 168, 76, 0.15);
        color: var(--gold-dim);
    }

    .chip-sage {
        background: rgba(90, 122, 106, 0.15);
        color: var(--sage);
    }

    .grade-slider {
        -webkit-appearance: none;
        appearance: none;
        height: 4px;
        border-radius: 2px;
        background: var(--border);
        outline: none;
    }

        .grade-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--gold);
            cursor: pointer;
        }

        .grade-slider::-moz-range-thumb {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--gold);
            cursor: pointer;
            border: none;
        }
</style>

<script>
    function updateScore(slider, targetId) {
        document.getElementById(targetId).textContent = slider.value;
    }

    function calculateTotal() {
        // Simular cálculo del total
        const total = 76;
        document.getElementById('total-score').textContent = total;

        const status = total >= 70 ? '✅ Passed' : '❌ Failed';
        const color = total >= 70 ? 'var(--sage)' : 'var(--rust)';

        alert(`Total Score: ${total}/100\nStatus: ${status}`);
    }

    function submitGrade() {
        if (confirm('Are you sure you want to submit the grades for this student?')) {
            alert('Grades submitted successfully!');
            window.location.href = '@Url.Action("CourseManagement", "Pages", new { id = 1 })';
        }
    }
</script>