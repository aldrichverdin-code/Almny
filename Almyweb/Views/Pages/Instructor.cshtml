@{
    ViewData["Title"] = "Instructor";
}

<div class="page active" id="page-dashboard">
    <div class="page-inner">
        <div class="section-header">
            <div class="section-eyebrow">Instructor Hub</div>
            <h2 class="section-title">Dashboard</h2>
            <p class="section-sub">
                Manage your courses, content, and AI-powered quizzes
            </p>
        </div>

        <!-- Stats -->
        <div class="dash-grid" id="dash-stats">
            <div class="dash-stat">
                <div class="dash-stat-icon gold">📚</div>
                <div>
                    <div class="dash-stat-val">0</div>
                    <div class="dash-stat-lbl">Your Courses</div>
                </div>
            </div>
            <div class="dash-stat">
                <div class="dash-stat-icon sage">🏫</div>
                <div>
                    <div class="dash-stat-val">—</div>
                    <div class="dash-stat-lbl">Total Platform Courses</div>
                </div>
            </div>
            <div class="dash-stat">
                <div class="dash-stat-icon ink">🤖</div>
                <div>
                    <div class="dash-stat-val">AI</div>
                    <div class="dash-stat-lbl">Quiz Generator</div>
                </div>
            </div>
        </div>

        <div class="tabs">
            <span class="tab active" data-tab="courses">My Courses</span>
            <span class="tab" data-tab="create">Create Course</span>
            <span class="tab" data-tab="sections">Add Section</span>
            <span class="tab" data-tab="lessons">Add Lesson</span>
            <span class="tab" data-tab="exams">Create Exam</span>
            <span class="tab" data-tab="ai">AI Quiz</span>
        </div>

        <!-- My Courses -->
        <div id="dash-courses" class="tab-content active">
            <div class="course-grid" id="my-courses-grid">
                <!-- Curso de ejemplo 1 -->
                <a href="@Url.Action("CourseManagement", "Pages", new { id = 1 })" style="text-decoration: none; color: inherit;">
                    <div class="course-card">
                        <div class="course-thumb" style="background: #1e3a5f">
                            <div class="course-thumb-icon">💻</div>
                            <div class="course-category-badge">Published</div>
                        </div>
                        <div class="course-info">
                            <div class="course-title">Full-Stack Web Development</div>
                            <div class="course-instructor">By You</div>
                            <div class="course-meta">
                                <div class="course-price">$49.99</div>
                                <span class="btn btn-outline btn-sm">Edit</span>
                            </div>
                        </div>
                        <div style="padding: 0 1.2rem 1rem;">
                            <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--muted);">
                                <span>📚 3 sections</span>
                                <span>👨‍🎓 12 students</span>
                            </div>
                        </div>
                    </div>
                </a>

                <!-- Curso de ejemplo 2 -->
                <a href="@Url.Action("CourseManagement", "Pages", new { id = 2 })" style="text-decoration: none; color: inherit;">
                    <div class="course-card">
                        <div class="course-thumb" style="background: #3d1a1a">
                            <div class="course-thumb-icon">🎨</div>
                            <div class="course-category-badge">Draft</div>
                        </div>
                        <div class="course-info">
                            <div class="course-title">UI/UX Design Mastery</div>
                            <div class="course-instructor">By You</div>
                            <div class="course-meta">
                                <div class="course-price free">Free</div>
                                <span class="btn btn-outline btn-sm">Edit</span>
                            </div>
                        </div>
                        <div style="padding: 0 1.2rem 1rem;">
                            <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--muted);">
                                <span>📚 2 sections</span>
                                <span>👨‍🎓 5 students</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <!-- Create Course -->
        <div id="dash-create" class="tab-content">
            <div class="form-section" style="max-width: 640px">
                <div class="form-section-title">New Course</div>
                <div style="display: flex; flex-direction: column; gap: 1rem">
                    <div class="form-two-col">
                        <div class="form-group">
                            <label class="form-label">Title *</label>
                            <input type="text" class="form-input" placeholder="Course title" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Category *</label>
                            <input type="text" class="form-input" placeholder="e.g. Programming" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Description *</label>
                        <textarea class="form-textarea" placeholder="What will students learn?"></textarea>
                    </div>
                    <div class="form-two-col">
                        <div class="form-group">
                            <label class="form-label">Thumbnail URL</label>
                            <input type="url" class="form-input" placeholder="https://…" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Price (0 = Free)</label>
                            <input type="number" class="form-input" placeholder="0" min="0" step="0.01" />
                        </div>
                    </div>
                    <button class="btn btn-primary">Publish Course →</button>
                </div>
            </div>
        </div>

        <!-- Add Section -->
        <div id="dash-sections" class="tab-content">
            <div class="form-section" style="max-width: 480px">
                <div class="form-section-title">Add Section to Course</div>
                <div style="display: flex; flex-direction: column; gap: 1rem">
                    <div class="form-group">
                        <label class="form-label">Course *</label>
                        <select class="form-select">
                            <option value="">Select a course</option>
                            <option>Full-Stack Web Development</option>
                            <option>UI/UX Design Mastery</option>
                        </select>
                    </div>
                    <div class="form-two-col">
                        <div class="form-group">
                            <label class="form-label">Section Title *</label>
                            <input type="text" class="form-input" placeholder="e.g. Introduction" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Order</label>
                            <input type="number" class="form-input" value="1" min="1" />
                        </div>
                    </div>
                    <button class="btn btn-primary">Add Section →</button>
                </div>
            </div>
        </div>

        <!-- Add Lesson -->
        <div id="dash-lessons" class="tab-content">
            <div class="form-section" style="max-width: 560px">
                <div class="form-section-title">Add Lesson to Section</div>
                <div style="display: flex; flex-direction: column; gap: 1rem">
                    <div class="form-group">
                        <label class="form-label">Section ID *</label>
                        <input type="text" class="form-input" placeholder="Section UUID" />
                        <span class="form-hint">Copy the section ID from your course sections</span>
                    </div>
                    <div class="form-two-col">
                        <div class="form-group">
                            <label class="form-label">Title *</label>
                            <input type="text" class="form-input" placeholder="Lesson title" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Order</label>
                            <input type="number" class="form-input" value="1" min="1" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Video URL</label>
                        <input type="url" class="form-input" placeholder="https://…" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Content / Notes</label>
                        <textarea class="form-textarea" placeholder="Lesson notes, transcript, or description…"></textarea>
                    </div>
                    <div class="form-group" style="flex-direction: row; align-items: center; gap: 0.5rem">
                        <input type="checkbox" id="les-free" style="width: 16px; height: 16px; accent-color: var(--gold)" />
                        <label for="les-free" class="form-label" style="margin: 0; text-transform: none; font-size: 0.85rem">Free Preview</label>
                    </div>
                    <button class="btn btn-primary">Add Lesson →</button>
                </div>
            </div>
        </div>

        <!-- Create Exam -->
        <div id="dash-exams" class="tab-content">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; max-width: 780px">
                <div class="form-section">
                    <div class="form-section-title">Create Exam</div>
                    <div style="display: flex; flex-direction: column; gap: 1rem">
                        <div class="form-group">
                            <label class="form-label">Course *</label>
                            <select class="form-select">
                                <option value="">Select a course</option>
                                <option>Full-Stack Web Development</option>
                                <option>UI/UX Design Mastery</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Exam Title *</label>
                            <input type="text" class="form-input" placeholder="e.g. Module 1 Quiz" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Duration (minutes) *</label>
                            <input type="number" class="form-input" value="30" min="1" />
                        </div>
                        <button class="btn btn-primary">Create Exam →</button>
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-section-title">Add Question</div>
                    <div style="display: flex; flex-direction: column; gap: 0.8rem">
                        <div class="form-group">
                            <label class="form-label">Exam ID *</label>
                            <input type="text" class="form-input" placeholder="Exam UUID" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Question *</label>
                            <input type="text" class="form-input" placeholder="Question text" />
                        </div>
                        <div class="form-two-col" style="grid-template-columns: 1fr 1fr">
                            <div class="form-group">
                                <label class="form-label">Option A</label>
                                <input type="text" class="form-input" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Option B</label>
                                <input type="text" class="form-input" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Option C</label>
                                <input type="text" class="form-input" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Option D</label>
                                <input type="text" class="form-input" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Correct Answer (A/B/C/D)</label>
                            <select class="form-select">
                                <option>A</option>
                                <option>B</option>
                                <option>C</option>
                                <option>D</option>
                            </select>
                        </div>
                        <button class="btn btn-primary">Add Question →</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- AI Quiz Generator -->
        <div id="dash-ai" class="tab-content">
            <div style="max-width: 640px; display: flex; flex-direction: column; gap: 1.25rem">
                <div class="ai-panel">
                    <div class="ai-panel-title">🤖 AI Quiz Generator</div>
                    <div class="ai-panel-sub">
                        Paste lesson content and let AI generate 5 multiple-choice questions instantly.
                    </div>
                    <textarea class="form-textarea" id="ai-content" style="background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.12); color: var(--paper); min-height: 120px" placeholder="Paste your lesson content here…"></textarea>
                    <button class="btn btn-gold mt-2">Generate Questions →</button>
                </div>
                <div id="ai-output">
                    <div class="ai-panel">
                        <div class="ai-panel-title mb-1">Generated Questions</div>
                        <div class="ai-result">AI-generated questions will appear here</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const tabs = document.querySelectorAll('.tab');
        const contents = {};

        // Mapear todas las pestañas con sus contenidos
        tabs.forEach(tab => {
            const tabId = tab.dataset.tab;
            const content = document.getElementById('dash-' + tabId);
            if (content) {
                contents[tabId] = content;
            }
        });

        // Función para cambiar de pestaña
        function switchTab(tabId) {
            // Ocultar todos los contenidos
            Object.values(contents).forEach(content => {
                if (content) content.classList.remove('active');
            });

            // Mostrar el contenido seleccionado
            if (contents[tabId]) {
                contents[tabId].classList.add('active');
            }

            // Actualizar clases de las pestañas
            tabs.forEach(tab => {
                tab.classList.remove('active');
                if (tab.dataset.tab === tabId) {
                    tab.classList.add('active');
                }
            });
        }

        // Agregar evento click a cada pestaña
        tabs.forEach(tab => {
            tab.addEventListener('click', function() {
                const tabId = this.dataset.tab;
                switchTab(tabId);
            });
        });

        // Mostrar la primera pestaña por defecto (courses)
        const firstTab = document.querySelector('.tab.active');
        if (firstTab) {
            const defaultTab = firstTab.dataset.tab;
            switchTab(defaultTab);
        } else {
            // Si no hay pestaña activa, activar la primera
            if (tabs.length > 0) {
                const firstTabId = tabs[0].dataset.tab;
                switchTab(firstTabId);
            }
        }
    });
</script>