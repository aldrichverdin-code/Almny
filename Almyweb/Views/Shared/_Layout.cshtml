<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Almny WEB</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Mono:wght@300;400;500&family=Instrument+Sans:wght@400;500;600&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- NAVBAR -->
    <nav class="nav" id="main-nav">
        <div class="nav-brand">A<span>M</span>T<span>C</span></div>
        <div class="nav-links">
            <a class="nav-btn active" href="@Url.Action("Index", "Home")">Discover</a>
            <a class="nav-btn" href="@Url.Action("MyLearn", "Pages")">My Learning</a>
            <a class="nav-btn" href="@Url.Action("Instructor", "Pages")">Instructor</a>
        </div>
        <div class="nav-auth">

            <a href="@Url.Action("Login", "Auth")"  class="btn btn-outline btn-sm">Sign In</a>
            <a href="@Url.Action("Register", "Auth")" class="btn btn-gold btn-sm">Join Free</a>
        </div>
    </nav>
    <!-- TOAST CONTAINER -->
    <div id="toast-container"></div>

    <!-- CONTENIDO PRINCIPAL -->
    <main>
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
