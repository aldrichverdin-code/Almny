@{
    ViewData["Title"] = "Sign In";
}
<div class="auth-wrap">
    <div class="auth-box">
        <div class="auth-header">
            <div class="auth-logo">Almn<span>y</span></div>
            <div class="auth-subtitle">Welcome back</div>
        </div>
        <div class="auth-body">
            <!-- Mensaje de error (ejemplo) -->
            <div style="background: #c0392b; color: #fff; padding: 0.75rem; border-radius: 8px; font-size: 0.85rem; margin-bottom: 1rem;">
                Invalid email or password
            </div>

            <!-- Mensaje de éxito (ejemplo - comentado) -->
            <!--
                <div style="background: #27ae60; color: #fff; padding: 0.75rem; border-radius: 8px; font-size: 0.85rem; margin-bottom: 1rem;">
                    Successfully registered! Please sign in.
                </div>
                -->

            <form>
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" class="form-input" placeholder="you@example.com" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-input" placeholder="••••••••" required />
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%;">Sign In →</button>
            </form>
            <div class="auth-switch">
                Don't have an account? <a href="register.html">Join Free</a>
            </div>
        </div>
    </div>
</div>